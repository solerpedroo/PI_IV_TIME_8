# Copie este arquivo para .env e preencha somente a cópia local.
# Nunca inclua a URI real, usuário ou senha em commits.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
JAVA_HOST=127.0.0.1
JAVA_PORT=8081
JAVA_BASE_URL=http://127.0.0.1:8081
# App / core no dia a dia:
MONGODB_DATABASE=agrogestao_dev
# API HTTP: banco = path da URI; se faltar path, usa MONGODB_DATABASE; URI e variável devem coincidir.
# Atlas: inclua /agrogestao_dev na URI; authSource conforme Connect → Drivers (geralmente admin).
# Para ./backend/core/testar.sh --atlas, troque temporariamente para um banco
# que termine em _teste (ex.: agrogestao_ci_teste) e conceda readWrite a ele.
MONGODB_URI='mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/agrogestao_dev?authSource=admin&retryWrites=true&w=majority&serverSelectionTimeoutMS=5000&connectTimeoutMS=5000'

# E-mail (opcional): sem SMTP_* o servidor imprime o codigo no console.
# Gmail: conta com 2FA, senha de app em https://myaccount.google.com/apppasswords
# (16 letras, pode colar com ou sem espacos). SMTP_FROM = SMTP_USERNAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=seu@gmail.com
SMTP_FROM=seu@gmail.com
# Com espacos (como o Google mostra), use aspas — sem aspas o shell so le a primeira palavra:
SMTP_PASSWORD='xxxx xxxx xxxx xxxx'
# Ou os 16 caracteres juntos, sem aspas: SMTP_PASSWORD=xxxxxxxxxxxxxxxx
